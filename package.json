{
  "name": "deepseek-api-status",
  "version": "0.2.0",
  "description": "DeepSeek API balance & usage panel for the DeepSeek Harness web GUI: always-visible strip above the Settings button — balance, cumulative/today spend, tokens, request counts, auto-refresh every minute.",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance",
    "usage"
  ],
  "author": "qianTouchFish",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qianTouchFish/dsh-deepseek-balance.git"
  },
  "homepage": "https://github.com/qianTouchFish/dsh-deepseek-balance",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.6"
  },
  "license": "MIT"
}
