{
    "name":  "dsh-deepseek-balance",
    "version":  "0.9.0",
    "description":  "DeepSeek API usage card for the DeepSeek Harness web GUI: always-visible strip above the Settings button + card anchored to its right — per-model and per-period spend/tokens/requests, official cumulative spend, live peak/off-peak pricing window badge, light/dark themes, auto-refresh every minute.",
    "keywords":  [
                     "deepseek",
                     "dsh",
                     "deepseek-harness",
                     "dsh-plugin",
                     "plugin",
                     "balance",
                     "usage"
                 ],
    "author":  "qianTouchFish",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/qianTouchFish/dsh-deepseek-balance.git"
                   },
    "homepage":  "https://github.com/qianTouchFish/dsh-deepseek-balance",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  {
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "default":  "./lib/client.js"
                                 },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml"
              ],
    "scripts":  {
                    "test":  "node test/client.cjs && node test/status.mjs",
                    "test:render":  "node test/render.cjs"
                },
    "devDependencies":  {
                            "react":  "^18.3.1",
                            "react-dom":  "^18.3.1"
                        },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-slots",
                                              "@deepseek-ai/dsh-client-ui-sidebar"
                                          ],
                               "platform":  "web"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "~4.0.4"
                         }
}